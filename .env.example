# Copy to .env at the repository root and fill in the initial admin password.
# Read by Docker Compose and by Spring Boot as Java properties.
# Use KEY=value without export or surrounding quotes.

POSTGRES_DB=infracture
POSTGRES_USER=infracture
POSTGRES_PASSWORD=infracture_dev

# Backend commands run from backend/; PostgreSQL settings are shared with Compose.
# Existing administrator credentials are not overwritten on restart.
INFRACTURE_ADMIN_USERNAME=infracture
INFRACTURE_ADMIN_EMAIL=admin@example.com
INFRACTURE_ADMIN_DISPLAY_NAME=Infradmin del caos
INFRACTURE_ADMIN_PASSWORD=
